<?xml version="1.0" encoding="utf-8"?>
<!--
  LynkApp Android Splash Screen Drawable
  Used by @capacitor/splash-screen and androidx.core:core-splashscreen

  This is the native Android splash drawable.
  It displays a centered LynkApp logo icon on a dark background (#0f0f0f).

  SECTION 2 STATUS: ✅ File created
  ACTION REQUIRED: Replace the circle/text with your actual exported logo icon.
  Steps:
    1. Export your logo from ../../Documents/lynkapp-logos.tsx as a 192x192 PNG
    2. Save as: android/app/src/main/res/drawable/splash_logo.png
    3. Replace this XML with a <bitmap> drawable, or use the Xcode/Android Studio
       Asset Studio to generate all density variants.

  For now this uses a vector drawable placeholder with the LynkApp "L" mark.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">

    <!-- Background fill — matches LynkApp dark theme -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f0f0f" />
        </shape>
    </item>

    <!-- Centered logo placeholder — replace with your actual bitmap icon -->
    <item
        android:gravity="center"
        android:width="120dp"
        android:height="120dp">
        <shape android:shape="oval">
            <!-- Purple brand color: #7c3aed -->
            <solid android:color="#7c3aed" />
        </shape>
    </item>

</layer-list>
